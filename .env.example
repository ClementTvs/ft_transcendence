# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence

# Backend JWT & encryption — use long random strings in production
SECRET_KEY=change-this-to-a-long-random-secret
ENCRYPTION_KEY=change-this-to-a-long-random-key

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://localhost:8080
FRONTEND_URL=https://localhost:8080

# SMTP (optional — password reset links are logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
